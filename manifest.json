{
  "manifest_version": 3,
  "name": "TCG Price Checker",
  "version": "2.0.0",
  "description": "Compare trading card prices across supported online stores.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "permissions": ["storage", "activeTab", "sidePanel", "permissions"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "https://www.tcgplayer.com/*",
    "https://product-images.tcgplayer.com/*",
    "https://kanzengames.com/*",
    "https://untouchables.ca/*",
    "https://cardifyhobby.com/*",
    "https://elitecardstoronto.com/*",
    "https://bananagames.ca/*",
    "https://kadoone.ca/*",
    "https://rotostcg.ca/*",
    "https://www.401games.com/*",
    "https://store.401games.ca/*",
    "https://mantatrading.com/*",
    "https://www.hobbiesville.com/*",
    "https://emmettstoystop.com/*",
    "https://www.rednails2.com/*",
    "https://chonkycollectibles.com/*",
    "https://www.sequencecomics.ca/*",
    "https://legendarycollectables.com/*",
    "https://redriotgames.ca/*",
    "https://www.thestrawhat.ca/*",
    "https://clutchgames.ca/*",
    "https://deckoutgaming.ca/*"
  ],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "TCG Price Checker",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.tcgplayer.com/*",
        "https://store.401games.ca/*",
        "https://kanzengames.com/*", "https://untouchables.ca/*", "https://cardifyhobby.com/*",
        "https://elitecardstoronto.com/*", "https://bananagames.ca/*", "https://kadoone.ca/*",
        "https://rotostcg.ca/*", "https://www.401games.com/*", "https://mantatrading.com/*",
        "https://www.hobbiesville.com/*", "https://emmettstoystop.com/*", "https://www.rednails2.com/*",
        "https://chonkycollectibles.com/*", "https://www.sequencecomics.ca/*",
        "https://legendarycollectables.com/*", "https://redriotgames.ca/*",
        "https://www.thestrawhat.ca/*", "https://clutchgames.ca/*", "https://deckoutgaming.ca/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
